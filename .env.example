# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Telegram userbot (https://my.telegram.org)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash

# Business bot token (@BotFather)
BOT_TOKEN=123456:ABC...

# Your Telegram user id (numeric) — куда слать уведомления о лидах
MY_TELEGRAM_ID=123456789

# Через запятую, без @ — например: startup_chat,founders_ru
TARGET_GROUPS=group1,group2

# Модель Claude
CLAUDE_MODEL=claude-sonnet-4-6
